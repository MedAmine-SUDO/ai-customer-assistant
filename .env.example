# Copy to .env and adjust. Without any key the app runs on a built-in mock LLM.

ENVIRONMENT=development
# Required in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Where the app is reachable from outside (WhatsApp webhook, links in alerts).
# Leave empty on Vercel: the production URL is used automatically.
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/assistant
CORS_ORIGINS=*

# --- LLM -------------------------------------------------------------------
# mock (no key, for tests), openai, or gemini (free tier: a key from aistudio.google.com/apikey)
LLM_PROVIDER=mock
OPENAI_API_KEY=
# For Gemini, also set CHAT_MODEL / EXTRACTION_MODEL (e.g. gemini-2.5-flash),
# EMBEDDING_MODEL=gemini-embedding-001 and the paid prices from aistudio.google.com/docs/pricing.
# Free-tier content may be used by Google to improve its products.
# Gemini embeddings sit closer together: RETRIEVAL_MAX_DISTANCE=0.42 (0.75 for OpenAI).
GEMINI_API_KEY=
# true on a free tier: the demo page then says its costs are the paid tier's prices
LLM_FREE_TIER=false
# Tried once when the main model is overloaded (e.g. gemini-3.5-flash-lite)
FALLBACK_MODEL=
CHAT_MODEL=gpt-5-mini
# Sent to reasoning models only. minimal = fastest and cheapest.
REASONING_EFFORT=minimal
EMBEDDING_MODEL=text-embedding-3-small
EXTRACTION_MODEL=gpt-5-mini
# USD per 1M tokens (paid price), used to log the cost of every answer.
PRICE_INPUT_PER_M=0.25
PRICE_CACHED_INPUT_PER_M=0.025
PRICE_OUTPUT_PER_M=2.00
PRICE_EMBEDDING_PER_M=0.02
USD_TO_TND=2.95

# --- Guards for a public demo on a real key -------------------------------
MAX_MESSAGES_PER_CONVERSATION=40
MAX_CONVERSATIONS_PER_IP_PER_DAY=25
DAILY_BUDGET_USD=2.00

# --- Where leads go: any of sheets, email, n8n ---------------------------------
# Live demo (no n8n): sheets,email. With docker compose: sheets,n8n (n8n sends the e-mails)
LEAD_SINKS=sheets,email
# 1440 = 24 h. Set 2 to film the follow-up in a video.
FOLLOWUP_DELAY_MINUTES=1440

# Google Sheets: a service account's JSON key (raw or base64), and the sheet shared with its e-mail
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
# Optional view-only link shown on the demo page
PUBLIC_SHEET_URL=

# Team e-mails (new lead, handoff, follow-up to do). Gmail: smtp.gmail.com, port 587, your address
# and an app password (myaccount.google.com/apppasswords). docker compose uses Mailpit instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# One address or several, separated by commas
TEAM_EMAIL=

# WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; type the same one in the app's webhook settings
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret (every webhook call is signed with it)
WHATSAPP_APP_SECRET=
# The business number customers write to, for the demo page's links
WHATSAPP_DISPLAY_NUMBER=
# Optional: an approved template for follow-ups after WhatsApp's 24 h window
# ({{1}} = first name, {{2}} = business). Without one, the team gets the follow-up by e-mail.
WHATSAPP_FOLLOWUP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=fr

N8N_LEAD_WEBHOOK_URL=
# Bearer token n8n uses to call /internal/*. On Vercel, CRON_SECRET also works.
INTERNAL_SECRET=
CRON_SECRET=

# --- Dashboard ----------------------------------------------------------
ADMIN_PASSWORD=demo1234
# Public demo: masks phone numbers in the dashboard, sheet and alerts
DEMO_MODE=true
SEED_DEMO=true
